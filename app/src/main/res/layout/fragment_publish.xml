<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="#33FFFFFF"
            android:gravity="center"
            android:text="Toque para adicionar um Banner (Opcional)"
            android:textColor="#B3FFFFFF"
            android:textStyle="italic"
            android:id="@+id/btnAddBanner" />

        <LinearLayout
            android:id="@+id/layoutHeaderPublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/publicar_titulo"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/publicar_subtitulo"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#66FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/publicar_secao_sobre"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/publicar_hint_titulo"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_agenda"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="@string/publicar_hint_descricao"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/publicar_secao_detalhes"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/publicar_hint_categoria"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_compass"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/publicar_hint_nivel"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/btn_star_big_on"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtNivel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:completionThreshold="0"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="@string/publicar_hint_prazo"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_recent_history"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPrazo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    android:background="#33FFFFFF" />

                <TextView
                    android:id="@+id/txtSecaoVisibilidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="@string/publicar_secao_visibilidade"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPublicarComo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="@string/publicar_hint_como"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtPublicarComo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:id="@+id/layoutInfoVisibilidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1A0D226B"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgIconeVisibilidade"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/txtInfoVisibilidade"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/publicar_info_publico"
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#0D226B"
            android:text="@string/publicar_btn"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

    </LinearLayout>
</ScrollView>