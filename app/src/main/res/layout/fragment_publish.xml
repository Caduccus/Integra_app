<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- ⭐ Cabeçalho (id pra esconder na EditarTrabalhoActivity) -->
        <LinearLayout
            android:id="@+id/layoutHeaderPublicar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/ic_add"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Publicar trabalho"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Preencha os dados abaixo"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:layout_marginBottom="24dp" />

        <!-- Card Container do Formulário -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#66FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Seção: Sobre o trabalho -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="SOBRE O TRABALHO"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Título -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Título do trabalho"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_agenda"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtTitulo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Descrição -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="Descrição detalhada"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescricao"
                        android:layout_width="match_parent"
                        android:layout_height="120dp"
                        android:gravity="top"
                        android:inputType="textMultiLine"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    android:background="#33FFFFFF" />

                <!-- Seção: Detalhes -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="DETALHES"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Categoria -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Categoria"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_compass"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtCategoria"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Nível -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="Nível de experiência"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/btn_star_big_on"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtNivel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:completionThreshold="0"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Prazo -->
                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hint="Prazo (ex: 30 dias)"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_recent_history"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtPrazo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Divisor -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="20dp"
                    android:background="#33FFFFFF" />

                <!-- ⭐ Seção: Visibilidade (id pra esconder na edição) -->
                <TextView
                    android:id="@+id/txtSecaoVisibilidade"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:text="VISIBILIDADE"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- ⭐ Publicar como (id pra esconder na edição) -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPublicarComo"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:hint="Publicar como"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtPublicarComo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Info box dinâmica -->
                <LinearLayout
                    android:id="@+id/layoutInfoVisibilidade"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#1A0D226B"
                    android:orientation="horizontal"
                    android:padding="12dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/imgIconeVisibilidade"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginEnd="10dp"
                        android:src="@android:drawable/ic_menu_info_details"
                        app:tint="#B3FFFFFF" />

                    <TextView
                        android:id="@+id/txtInfoVisibilidade"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Trabalho público: qualquer pessoa pode ver e se candidatar."
                        android:textColor="#B3FFFFFF"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Botão Publicar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublicar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#0D226B"
            android:text="PUBLICAR TRABALHO"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

    </LinearLayout>
</ScrollView>