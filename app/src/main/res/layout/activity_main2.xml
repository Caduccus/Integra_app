<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="220dp">
        <ImageView
            android:id="@+id/imgBannerTrabalho"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:background="#0D226B" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_gradient_banner" />
        <ImageView
            android:id="@+id/btnVoltar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/white" />
        <ImageView
            android:id="@+id/btnCompartilhar"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end"
            android:layout_margin="16dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_share"
            app:tint="@color/white" />
    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">
            <TextView
                android:id="@+id/txtCriador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />
            <TextView
                android:id="@+id/txtTituloDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/trabalho_secao_descricao"
                android:textColor="#8696A0"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtDescricaoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E9EDEF"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/trabalho_secao_categoria"
                android:textColor="#8696A0"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtCategoriaDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E9EDEF"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/txtTipoContratoDetalhe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/trabalho_secao_nivel"
                android:textColor="#8696A0"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtNivelDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E9EDEF"
                android:textSize="15sp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/trabalho_secao_prazo"
                android:textColor="#8696A0"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/txtPrazoDetalhe"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#E9EDEF"
                android:textSize="15sp" />
            <LinearLayout
                android:id="@+id/layoutBotoesCriador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:orientation="horizontal"
                android:weightSum="3"
                android:visibility="gone">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExcluir"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:backgroundTint="#D32F2F"
                    android:text="@string/trabalho_btn_excluir"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:cornerRadius="12dp" />
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditar"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginHorizontal="4dp"
                    android:backgroundTint="#0D226B"
                    android:text="@string/trabalho_btn_editar"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    app:cornerRadius="12dp" />
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp">
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnChat"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:backgroundTint="#1E88E5"
                        android:text="@string/trabalho_btn_candidatos"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        app:cornerRadius="12dp" />
                    <TextView
                        android:id="@+id/badgeCandidatos"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="top|end"
                        android:layout_marginTop="4dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/badge_background"
                        android:gravity="center"
                        android:paddingHorizontal="6dp"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:visibility="gone" />
                </FrameLayout>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCandidatar"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:backgroundTint="#0D226B"
                android:text="@string/trabalho_btn_candidatar"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:visibility="gone"
                app:cornerRadius="28dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>