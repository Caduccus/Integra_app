<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background_gradiente">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtTituloTela"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="25dp"
            android:text="Detalhes do Trabalho"
            android:textColor="#000000"
            android:textSize="28sp"
            android:textStyle="bold" />

        <!-- TÍTULO -->
        <TextView
            android:id="@+id/txtTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="Título do Trabalho"
            android:textColor="#020202"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- DESCRIÇÃO -->
        <TextView
            android:id="@+id/txtDescricao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="16dp"
            android:text="Descrição detalhada do trabalho aqui..."
            android:textColor="#000000"
            android:textSize="16sp" />

        <!-- CATEGORIA -->
        <TextView
            android:id="@+id/txtCategoria"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Categoria: Design"
            android:textColor="#050505"
            android:textSize="14sp" />

        <!-- PRAZO -->
        <TextView
            android:id="@+id/txtPrazo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="30dp"
            android:text="Prazo: 15/10/2026"
            android:textColor="#0D0D0D"
            android:textSize="14sp" />

        <!-- CONTAINER DOS BOTÕES (LADO A LADO) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnExcluir"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#D32F2F"
                android:text="EXCLUIR"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnEditar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:backgroundTint="#F57C00"
                android:text="EDITAR"
                android:textSize="12sp"/>

            <Button
                android:id="@+id/btnChat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="#0D226B"
                android:text="CHAT"
                android:textSize="12sp"/>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
