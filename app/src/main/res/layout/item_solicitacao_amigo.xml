<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp">

    <ImageView
        android:id="@+id/imgSolicitante"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/ic_person"
        app:tint="#8696A0" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/txtNomeSolicitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E9EDEF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/txtUsernameSolicitante"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#8696A0"
            android:textSize="12sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAceitarSolicitacao"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:layout_marginEnd="4dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="ACEITAR"
        android:textColor="@color/white"
        android:textSize="11sp"
        app:backgroundTint="#43A047"
        app:cornerRadius="18dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnRecusarSolicitacao"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:minWidth="0dp"
        android:paddingHorizontal="12dp"
        android:text="RECUSAR"
        android:textColor="#EF5350"
        android:textSize="11sp"
        app:cornerRadius="18dp"
        app:strokeColor="#EF5350"
        app:strokeWidth="1.5dp" />
</LinearLayout>