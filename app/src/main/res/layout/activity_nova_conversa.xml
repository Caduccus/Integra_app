<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B141A"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1F2C34"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="12dp">

        <ImageView
            android:id="@+id/btnVoltarNovaConversa"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:padding="8dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="#AEBAC1" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Nova Conversa"
            android:textColor="#E9EDEF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Busca -->
    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:hint="Buscar usuário..."
        android:textColorHint="#8696A0"
        app:boxBackgroundColor="#202C33"
        app:boxStrokeColor="#1E88E5"
        app:boxStrokeWidth="1.5dp"
        app:hintTextColor="#1E88E5"
        app:startIconDrawable="@android:drawable/ic_menu_search"
        app:startIconTint="#8696A0">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edtBuscaUsuario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName"
            android:textColor="#E9EDEF" />
    </com.google.android.material.textfield.TextInputLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvUsuariosNovaConversa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingHorizontal="8dp"
            tools:listitem="@layout/item_usuario_busca" />

        <LinearLayout
            android:id="@+id/layoutVazioUsuarios"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nenhum usuário encontrado."
                android:textColor="#8696A0"
                android:textSize="16sp" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>