<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/containerMensagem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <LinearLayout
        android:id="@+id/linhaMensagem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom">

        <!-- Foto do Remetente (Oculta no 1 a 1, mas mantida para o código não quebrar) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFotoRemetente"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="6dp"
            android:visibility="gone"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">
            <ImageView
                android:id="@+id/imgFotoRemetente"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="6dp"
                android:src="@drawable/ic_person"
                app:tint="@color/white" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/bubbleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:maxWidth="300dp"
            android:padding="6dp"
            android:background="@drawable/bg_msg_in">

            <TextView
                android:id="@+id/txtNomeRemetente"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="2dp"
                android:text="Nome"
                android:textColor="#1E88E5"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Citação (Reply) -->
            <LinearLayout
                android:id="@+id/layoutReply"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:background="#1AFFFFFF"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:layout_width="4dp"
                    android:layout_height="match_parent"
                    android:background="#1E88E5" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="6dp">
                    <TextView
                        android:id="@+id/txtReplyNome"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Nome"
                        android:textColor="#1E88E5"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtReplyTexto"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:text="Mensagem respondida"
                        android:textColor="#8696A0"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Imagem -->
            <ImageView
                android:id="@+id/imgMensagem"
                android:layout_width="250dp"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <!-- Áudio -->
            <LinearLayout
                android:id="@+id/layoutAudio"
                android:layout_width="240dp"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/btnPlayAudio"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_play"
                    app:tint="#8696A0" />
                <com.example.plataformaremota.AudioWaveformView
                    android:id="@+id/waveformAudio"
                    android:layout_width="0dp"
                    android:layout_height="26dp"
                    android:layout_marginHorizontal="8dp"
                    android:layout_weight="1" />
                <TextView
                    android:id="@+id/txtDuracaoAudio"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0:00"
                    android:textColor="#8696A0"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Arquivo -->
            <LinearLayout
                android:id="@+id/layoutArquivo"
                android:layout_width="220dp"
                android:layout_height="wrap_content"
                android:background="#1AFFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="10dp"
                android:visibility="gone">
                <ImageView
                    android:id="@+id/imgIconeArquivo"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginEnd="10dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_file"
                    app:tint="#1E88E5" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/txtNomeArquivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:text="arquivo.pdf"
                        android:textColor="#E9EDEF"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/txtTamanhoArquivo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="120 KB"
                        android:textColor="#8696A0"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Texto -->
            <TextView
                android:id="@+id/txtTextoMensagem"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:paddingHorizontal="4dp"
                android:text="Mensagem"
                android:textColor="#E9EDEF"
                android:textSize="15sp" />

            <!-- Rodapé (Hora + Check) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="4dp">

                <TextView
                    android:id="@+id/txtEditada"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="4dp"
                    android:text="editada"
                    android:textColor="#8696A0"
                    android:textSize="11sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/txtHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="12:00"
                    android:textColor="#8696A0"
                    android:textSize="11sp" />

                <!-- Check Azul Integra -->
                <ImageView
                    android:id="@+id/imgCheck"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_done_all"
                    app:tint="#1E88E5"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>