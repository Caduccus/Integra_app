<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardCandidato"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#F2FFFFFF"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ic_person"
            app:tint="#0D226B" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtNomeCandidato"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nome do Candidato"
                android:textColor="#0D226B"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtDataCandidatura"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Candidatou-se em..."
                android:textColor="#888888"
                android:textSize="12sp" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAbrirChatCandidato"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="CHAT"
            android:textColor="@color/white"
            android:textSize="11sp"
            android:textStyle="bold"
            app:backgroundTint="#0D226B"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_chat"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:iconSize="14dp"
            app:iconTint="@color/white" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>