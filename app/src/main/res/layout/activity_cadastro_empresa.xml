<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/btnVoltarCadastroEmpresa"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_arrow_back"
                app:tint="@color/white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/nova_empresa_titulo"
                android:textColor="@color/white"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Logo -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogoEmpresa"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:clickable="true"
                android:focusable="true"
                app:cardBackgroundColor="#33FFFFFF"
                app:cardCornerRadius="60dp"
                app:cardElevation="0dp"
                app:strokeWidth="2dp"
                app:strokeColor="#66FFFFFF">

                <ImageView
                    android:id="@+id/imgLogoEmpresa"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="36dp"
                    android:src="@drawable/ic_add_circle"
                    app:tint="@color/white" />
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/nova_empresa_logo"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- BOTÃO DE BANNER (Adicionado aqui) -->
        <TextView
            android:id="@+id/btnAddBannerEmpresa"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginHorizontal="0dp"
            android:layout_marginBottom="24dp"
            android:background="#1F2C34"
            android:gravity="center"
            android:text="Toque para adicionar um Banner (Opcional)"
            android:textColor="#8696A0"
            android:textStyle="italic" />

        <!-- Card do formulário -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#33FFFFFF"
            app:cardCornerRadius="20dp"
            app:cardElevation="6dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="#66FFFFFF">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/nova_empresa_hint_nome"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtNomeEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="60"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/nova_empresa_hint_descricao"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_edit"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtDescricaoEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:gravity="top"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLength="300"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/nova_empresa_hint_cnpj"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_info_details"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtCnpjEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text"
                        android:maxLength="30"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/nova_empresa_hint_area"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_compass"
                    app:startIconTint="@color/white"
                    app:endIconTint="@color/white">

                    <AutoCompleteTextView
                        android:id="@+id/edtAreaEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hint="@string/nova_empresa_hint_endereco"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEnderecoEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="text|textCapSentences"
                        android:maxLength="120"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/nova_empresa_hint_email"
                    android:textColorHint="#B3FFFFFF"
                    app:boxStrokeColor="@color/white"
                    app:boxStrokeWidth="1.5dp"
                    app:boxBackgroundColor="@android:color/transparent"
                    app:hintTextColor="@color/white"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="@color/white">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/edtEmailEmpresa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:maxLength="80"
                        android:textColor="@color/white" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCriarEmpresa"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:backgroundTint="#43A047"
            android:text="@string/empresas_btn_criar_empresa"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            app:cornerRadius="28dp"
            app:elevation="4dp"
            app:icon="@drawable/ic_add"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="* Campos obrigatórios"
            android:textAlignment="center"
            android:textColor="#80FFFFFF"
            android:textSize="11sp"
            android:textStyle="italic" />

    </LinearLayout>
</ScrollView>